# Robinhood Chain mainnet (4663), or the Anvil fork with the same chain ID.
EXPO_PUBLIC_CHAIN_ID=4663
EXPO_PUBLIC_RPC_URL=http://127.0.0.1:8549
EXPO_PUBLIC_API_URL=http://127.0.0.1:4620
# Injected wallet is recommended on the fork. Configure a Robinhood-enabled
# Privy app/client before switching to embedded wallets.
EXPO_PUBLIC_WALLET=injected
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_PRIVY_WEB_CLIENT_ID=
EXPO_PUBLIC_APP_URL=
# A local Anvil fork (scripts/fork): say so in the UI, and send transaction
# links to the API's read-only explorer, since public explorers never saw them.
# EXPO_PUBLIC_FORK=1
# EXPO_PUBLIC_EXPLORER_URL=http://127.0.0.1:4630/api/explorer
