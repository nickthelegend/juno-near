# NEAR testnet. Copy to .env.local (gitignored) and fill in.
# The factory account every post is a sub-account of (written by `pnpm testnet:run`).
EXPO_PUBLIC_JUNO_FACTORY=
EXPO_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
# The Juno relayer (`pnpm relayer`): email sign-in and NEP-366 meta transactions.
EXPO_PUBLIC_RELAYER_URL=http://127.0.0.1:8787
# A NEAR mainnet account named as recipient in 1Click dry quotes. No swap is sent.
EXPO_PUBLIC_NEAR_MAINNET_ACCOUNT=
# Where relative media paths resolve on native builds; web uses its own origin.
EXPO_PUBLIC_APP_URL=
